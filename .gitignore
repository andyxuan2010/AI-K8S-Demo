# Terraform working directories and generated state/plans
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local Terraform overrides and generated variable files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json
!environments/dev/terraform.tfvars
*.tfvars.local
# Keep .terraform.lock.hcl tracked for reproducible provider installs.

# Credentials and local secrets
credentials
.env
*id_rsa
id_rsa*
**/k8s/.kube/*
!k8s/.kube/.gitkeep

# Local development environments and editor settings
**/venv/*
.vscode/

# Python bytecode and caches
__pycache__/
*.py[cod]

# Operating-system files
.DS_Store
Thumbs.db
